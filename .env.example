# local | beta | production
STORE_ENV=local

# Public canonical origin for this deployment (no trailing slash)
SITE_URL=http://localhost:3000

# At least 32 random characters. Use a different value in every environment.
AUTH_SECRET=replace-with-a-long-random-secret

# MySQL/MariaDB connection used by Prisma. Keep beta and production separate.
# URL-encode special characters in user/password values.
DATABASE_URL=mysql://rr_store_user:change-me@127.0.0.1:3306/rr_store_local

# Dedicated empty database used only by `prisma migrate dev`. Never point this
# variable to the same database as DATABASE_URL.
SHADOW_DATABASE_URL=mysql://rr_store_user:change-me@127.0.0.1:3306/rr_store_shadow

# Persistent media directory outside the deployed application directory.
MEDIA_ROOT=C:/persistent/rr-store/media

# Used only by `npm run admin:create`; do not commit real values.
# ADMIN_INITIAL_EMAIL=admin@example.com
# ADMIN_INITIAL_PASSWORD=replace-with-a-long-password
