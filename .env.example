# local | beta | production
STORE_ENV=local

# Public canonical origin for this deployment (no trailing slash)
SITE_URL=http://localhost:3000

# MySQL/MariaDB connection used by Prisma. Keep beta and production separate.
# URL-encode special characters in user/password values.
DATABASE_URL=mysql://rr_store_user:change-me@127.0.0.1:3306/rr_store_local

# Persistent media directory outside the deployed application directory.
MEDIA_ROOT=C:/persistent/rr-store/media
